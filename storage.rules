rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Room video uploads — owner can write, anyone can read (for shared playback).
    match /room_uploads/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 500 * 1024 * 1024;
    }

    // Profile avatars — owner can write, anyone can read.
    match /profile_photos/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024;
    }
  }
}
